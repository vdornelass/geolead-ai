<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Temperatura__c</fullName>
    <description>Classificação automática baseada no Score Final.</description>
    <externalId>false</externalId>
    <formula>IF(Score_Final__c >= 75, "QUENTE", IF(Score_Final__c >= 40, "MORNO", "FRIO"))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Temperatura do Lead</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
